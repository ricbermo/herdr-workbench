{
  "id": "root",
  "cloned_from": {
    "name": "herdr-t3",
    "version": "0.1.13"
  },
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "t3-chrome"
          },
          "size": {
            "px": 40
          },
          "window_drag": true
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "lists",
              "type": "column",
              "children": [
                {
                  "id": "agents",
                  "type": "block",
                  "content": { "mod": "t3-agents" },
                  "size": { "weight": 1 },
                  "min": 90
                },
                {
                  "id": "spaces",
                  "type": "block",
                  "content": {
                    "mod": "my-spaces",
                    "props": { "newMenu": "t3-new-menu" }
                  },
                  "size": { "weight": 1 },
                  "min": 90
                }
              ]
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "t3-chrome",
            "props": {
              "footer": true
            }
          },
          "size": {
            "px": 44
          }
        }
      ],
      "size": {
        "px": 256
      },
      "min": 208,
      "max": 480,
      "background": "chrome",
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs-row",
          "type": "row",
          "children": [
            {
              "id": "tabs",
              "type": "block",
              "content": {
                "mod": "t3-tabs"
              },
              "size": {
                "weight": 1
              },
              "window_drag": true
            },
            {
              "id": "github-toggle",
              "type": "block",
              "content": { "mod": "my-github-toggle" },
              "size": { "px": 124 },
              "window_drag": true
            },
            {
              "id": "changes-toggle",
              "type": "block",
              "content": { "mod": "my-changes-toggle" },
              "size": { "px": 100 },
              "window_drag": true
            },
            {
              "id": "markdown-toggle",
              "type": "block",
              "content": { "mod": "my-markdown" },
              "size": { "px": 112 },
              "window_drag": true
            },
            {
              "id": "tabs-end",
              "type": "block",
              "content": {
                "mod": "t3-tabs",
                "props": {
                  "part": "end",
                  "block": "tabs-end"
                }
              },
              "size": {
                "px": 36
              },
              "window_drag": true
            }
          ],
          "size": {
            "px": 40
          },
          "background": "chrome",
          "resizable": false
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "t3-pane"
                    },
                    "reveal": "always",
                    "height": 28,
                    "position": "top"
                  },
                  "background": "background",
                  "border": {
                    "width": 2,
                    "color": "background"
                  },
                  "focus": {
                    "width": 2,
                    "color": "background"
                  },
                  "radius": 8,
                  "gap": 8,
                  "lone": true
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    { "id": "changes", "type": "block", "content": { "mod": "changes" } },
                    { "id": "github", "type": "block", "content": { "mod": "my-github" } }
                  ],
                  "active": "changes"
                }
              ],
              "size": { "px": 400 },
              "min": 300,
              "max": 650,
              "hidden": true
            }
          ],
          "padding": [
            0,
            8
          ],
          "gap": 8
        },
        {
          "id": "work-bottom-inset",
          "type": "row",
          "children": [
            {
              "id": "bar-measure",
              "type": "block",
              "content": {
                "mod": "t3-tabs",
                "props": {
                  "part": "measure"
                }
              },
              "size": {
                "weight": 1
              }
            }
          ],
          "size": {
            "px": 8
          }
        }
      ],
      "background": "chrome",
      "resizable": false
    }
  ],
  "background": "canvas",
  "theme": "dracula",
  "terminal_padding": [
    8,
    0
  ],
  "terminal_opacity": 0,
  "divider": {
    "width": 1,
    "color": "border"
  },
  "titlebar": "none",
  "traffic_lights": [
    16,
    12
  ],
  "preview": "layouts/preview.png",
  "terminal_menu": "t3-menu"
}
